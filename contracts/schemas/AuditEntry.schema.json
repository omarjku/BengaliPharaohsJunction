{
  "$defs": {
    "Alternative": {
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "minLength": 1,
          "title": "Product Id",
          "type": "string"
        },
        "summary": {
          "description": "Why this is offered instead.",
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "product_id",
        "summary"
      ],
      "title": "Alternative",
      "type": "object"
    },
    "AuditInput": {
      "additionalProperties": false,
      "properties": {
        "request": {
          "$ref": "#/$defs/PurchaseRequest"
        },
        "mandate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Mandate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "quotes": {
          "items": {
            "$ref": "#/$defs/Quote"
          },
          "title": "Quotes",
          "type": "array"
        }
      },
      "required": [
        "request"
      ],
      "title": "AuditInput",
      "type": "object"
    },
    "Availability": {
      "enum": [
        "available",
        "partial",
        "unavailable",
        "unknown"
      ],
      "title": "Availability",
      "type": "string"
    },
    "Channel": {
      "enum": [
        "text",
        "voice",
        "photo",
        "menu"
      ],
      "title": "Channel",
      "type": "string"
    },
    "CutOff": {
      "additionalProperties": false,
      "properties": {
        "closing_time": {
          "format": "date-time",
          "title": "Closing Time",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "closing_time",
        "passed"
      ],
      "title": "CutOff",
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Contract Version",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/Reason"
          },
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "alternatives": {
          "items": {
            "$ref": "#/$defs/Alternative"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "outcome",
        "reasons",
        "decided_at"
      ],
      "title": "Decision",
      "type": "object"
    },
    "HardRule": {
      "additionalProperties": false,
      "description": "A check that is either met or not. Breaking one justifies DECLINE\n(except AUTO_APPROVE_LIMIT_EUR, which only decides who signs off).",
      "properties": {
        "kind": {
          "$ref": "#/$defs/RuleKind"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "description": "Allergen/claim name, or a number, depending on kind.",
          "title": "Value"
        },
        "scope": {
          "$ref": "#/$defs/PreferenceScope",
          "default": "always"
        },
        "source_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The buyer's own words.",
          "title": "Source Text"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "HardRule",
      "type": "object"
    },
    "Mandate": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Contract Version",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "buyer_id": {
          "minLength": 1,
          "title": "Buyer Id",
          "type": "string"
        },
        "hard_rules": {
          "items": {
            "$ref": "#/$defs/HardRule"
          },
          "title": "Hard Rules",
          "type": "array"
        },
        "uncertainty_policy": {
          "$ref": "#/$defs/UncertaintyPolicy",
          "default": "ask"
        },
        "guidance": {
          "items": {
            "$ref": "#/$defs/Preference"
          },
          "title": "Guidance",
          "type": "array"
        },
        "open_questions": {
          "items": {
            "$ref": "#/$defs/OpenQuestion"
          },
          "title": "Open Questions",
          "type": "array"
        }
      },
      "required": [
        "id",
        "buyer_id"
      ],
      "title": "Mandate",
      "type": "object"
    },
    "OpenQuestion": {
      "additionalProperties": false,
      "description": "Something the compiler could not resolve; asked, not guessed.",
      "properties": {
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "why": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Why"
        }
      },
      "required": [
        "question"
      ],
      "title": "OpenQuestion",
      "type": "object"
    },
    "Outcome": {
      "enum": [
        "AUTO",
        "ASK_HUMAN",
        "DECLINE"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "Preference": {
      "additionalProperties": false,
      "description": "Soft guidance that is not a clean check; shapes ranking, never blocks.",
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/PreferenceScope"
        }
      },
      "required": [
        "text",
        "scope"
      ],
      "title": "Preference",
      "type": "object"
    },
    "PreferenceScope": {
      "description": "How long a preference lasts (D5: don't over-generalise).",
      "enum": [
        "this_order",
        "always"
      ],
      "title": "PreferenceScope",
      "type": "string"
    },
    "PurchaseRequest": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Contract Version",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "buyer_id": {
          "minLength": 1,
          "title": "Buyer Id",
          "type": "string"
        },
        "text": {
          "description": "The original words, kept for the audit trail.",
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "channel": {
          "$ref": "#/$defs/Channel",
          "default": "text"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/RequestItem"
          },
          "title": "Items",
          "type": "array"
        },
        "needed_by": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Needed By"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "buyer_id",
        "text",
        "created_at"
      ],
      "title": "PurchaseRequest",
      "type": "object"
    },
    "QuantityInfo": {
      "additionalProperties": false,
      "description": "Available quantity. `known=False` means unknown, NOT unlimited\n(the mock API reports Terminal stock as 999999).",
      "properties": {
        "known": {
          "title": "Known",
          "type": "boolean"
        },
        "value": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "known"
      ],
      "title": "QuantityInfo",
      "type": "object"
    },
    "Quote": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Contract Version",
          "type": "string"
        },
        "product_id": {
          "minLength": 1,
          "title": "Product Id",
          "type": "string"
        },
        "product_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Name"
        },
        "unit_price_eur": {
          "minimum": 0,
          "title": "Unit Price Eur",
          "type": "number"
        },
        "unit": {
          "description": "Sales unit, e.g. '1 L carton'.",
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "availability": {
          "$ref": "#/$defs/Availability"
        },
        "quantity": {
          "$ref": "#/$defs/QuantityInfo"
        },
        "available_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Available Date"
        },
        "source": {
          "$ref": "#/$defs/QuoteSource"
        },
        "fetched_at": {
          "description": "Freshness: when this was read.",
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        },
        "cut_off": {
          "anyOf": [
            {
              "$ref": "#/$defs/CutOff"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "product_id",
        "unit_price_eur",
        "unit",
        "availability",
        "quantity",
        "source",
        "fetched_at"
      ],
      "title": "Quote",
      "type": "object"
    },
    "QuoteSource": {
      "enum": [
        "valio_api",
        "valio_front_door",
        "mock"
      ],
      "title": "QuoteSource",
      "type": "string"
    },
    "Reason": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ReasonCode"
        },
        "message": {
          "description": "Plain language, shown to the chef.",
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "product_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Id"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Reason",
      "type": "object"
    },
    "ReasonCode": {
      "enum": [
        "CUT_OFF_PASSED",
        "QUANTITY_UNKNOWN",
        "PARTIAL_STOCK",
        "UNAVAILABLE",
        "NOT_DELIVERABLE",
        "UNIT_MISMATCH",
        "OVER_SPEND_LIMIT",
        "LOW_CONFIDENCE",
        "SUBSTITUTION_OUTSIDE_PREFERENCES",
        "HARD_RULE_VIOLATED",
        "ALLERGEN_CONFLICT",
        "WITHIN_MANDATE"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "RejectedOption": {
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "minLength": 1,
          "title": "Product Id",
          "type": "string"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/Reason"
          },
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "product_id",
        "reasons"
      ],
      "title": "RejectedOption",
      "type": "object"
    },
    "RequestItem": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "What the buyer called it, e.g. 'lactose-free milk'.",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "quantity": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. 'L', 'KG', 'PCS'.",
          "title": "Unit"
        }
      },
      "required": [
        "name"
      ],
      "title": "RequestItem",
      "type": "object"
    },
    "RuleKind": {
      "description": "Closed list of checks a hard rule may express.",
      "enum": [
        "excluded_allergen",
        "required_claim",
        "max_unit_price_eur",
        "min_delivery_reliability",
        "auto_approve_limit_eur"
      ],
      "title": "RuleKind",
      "type": "string"
    },
    "UncertaintyPolicy": {
      "description": "What the agent does when it cannot verify something.",
      "enum": [
        "ask",
        "decline",
        "approve"
      ],
      "title": "UncertaintyPolicy",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Contract Version",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "actor": {
      "description": "e.g. 'buyer_agent', 'valio_front_door', 'human:<name>'.",
      "minLength": 1,
      "title": "Actor",
      "type": "string"
    },
    "input": {
      "$ref": "#/$defs/AuditInput"
    },
    "decision": {
      "$ref": "#/$defs/Decision"
    },
    "rejected_options": {
      "items": {
        "$ref": "#/$defs/RejectedOption"
      },
      "title": "Rejected Options",
      "type": "array"
    }
  },
  "required": [
    "id",
    "timestamp",
    "actor",
    "input",
    "decision"
  ],
  "title": "AuditEntry",
  "type": "object"
}
