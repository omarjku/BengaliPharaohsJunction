VALIO_API_KEY=
VALIO_BASE_URL=https://junction26.valioaimo.fi
GEMINI_API_KEY=
# Frontend URL(s) allowed to call the API, comma-separated (add the Render frontend URL there)
FRONTEND_ORIGINS=http://localhost:5173
# Front-door API keys (dummy values: use long random ones, e.g. `openssl rand -hex 24`), comma-separated key=buyer_id[:name].
# Unset = POST /api/orders, /api/orders/*, /api/audit answer 503. An agent key can never approve.
AGENT_KEYS=demo-agent-key-change-me=lapland-kitchen
APPROVER_KEYS=demo-approver-key-change-me=lapland-kitchen:Chef Aino
# Valio staff, read-only audit view across buyers (dummy value)
VALIO_ADMIN_KEYS=demo-valio-admin-key-change-me=valio:Valio ops
# Ed25519 signing key for order responses: base64 of 32 random bytes, e.g. `python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"`.
# Unset = an ephemeral key per process (signatures stop verifying after a restart). Never commit a real one.
FRONT_DOOR_SIGNING_KEY=
# Where orders, the audit trail and idempotency keys are stored (default: the repo's data/). On Render, mount a
# persistent disk and point this at it (e.g. /var/data) so state survives redeploys.
DATA_DIR=
# Set to 1 behind a proxy that appends the client IP to X-Forwarded-For (Render does), so per-IP rate limits see
# real callers. Leave unset when the API is reachable directly (the header would be spoofable).
TRUST_X_FORWARDED_FOR=
# 1 = allow POST /api/admin/demo/reset (archives orders/audit/idempotency under DATA_DIR/archive, starts fresh).
DEMO_RESET_ENABLED=
# Smoke-test buyer: add a smoke-kitchen entry to AGENT_KEYS and APPROVER_KEYS (seeded mandate in mandates.py), e.g.
# AGENT_KEYS=demo-agent-key-change-me=lapland-kitchen,demo-smoke-agent-key=smoke-kitchen:smoke agent
# APPROVER_KEYS=...,demo-smoke-approver-key=smoke-kitchen:Smoke approver
